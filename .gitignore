*.raw.json
level-check/

# Tooling
.DS_Store
.pio/
.cache/
build/

# Staging area for files to copy onto the reader SD card (fonts, test books). Never committed.
sd-card/

# Manga pipeline (tools/manga, docs/v0.2/manga.md): volumes, OCR output, converted books and cached API
# responses are private and stay out of the repo.
*.cbz
*.cbr
*.xtc
*.xtch
*.mokuro
*.lexi.json
_ocr/
api-cache/

# Local research workspace: manga volumes, OCR output, spike results, cached API responses, research notes
# and the OCR venv. Private; never committed (docs/v0.2/manga.md §3).
/research/

# Serial logs from the dev harness
device.log

# Python caches
__pycache__/
*.pyc
